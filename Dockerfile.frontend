FROM node:20.10.0
WORKDIR /app

# Copy package files first
COPY frontend/package*.json ./
COPY frontend/jsconfig.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy entire frontend directory
COPY frontend/ .

# Debug: Verify files exist before build
RUN echo "=== Directory structure ===" && \
    find . -type f -name "*.json" | head -20 && \
    echo "=== Checking /app/lib ===" && \
    ls -la lib/ && \
    echo "=== Checking /app/lib/hooks ===" && \
    ls -la lib/hooks/ && \
    echo "=== jsconfig.json content ===" && \
    cat jsconfig.json && \
    echo "=== Checking for nested frontend ===" && \
    if [ -d "frontend" ]; then echo "WARNING: nested frontend/ exists!" && ls -la frontend/; else echo "Good: no nested frontend/"; fi

# Build the application
RUN npm run build

# Expose port and start
EXPOSE 8080
CMD ["npm", "start", "--", "-p", "8080"]
