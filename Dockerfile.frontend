FROM node:20.10.0
WORKDIR /app

# Build arguments for Atlas Charts URLs
ARG NEXT_PUBLIC_ATLAS_CHART_PARTICLE_URL
ARG NEXT_PUBLIC_ATLAS_CHART_TEMPERATURE_URL
ARG NEXT_PUBLIC_ATLAS_CHART_RFPOWER_URL
ARG NEXT_PUBLIC_ATLAS_CHART_METRICS_URL

# Set as environment variables for the build
ENV NEXT_PUBLIC_ATLAS_CHART_PARTICLE_URL=$NEXT_PUBLIC_ATLAS_CHART_PARTICLE_URL
ENV NEXT_PUBLIC_ATLAS_CHART_TEMPERATURE_URL=$NEXT_PUBLIC_ATLAS_CHART_TEMPERATURE_URL
ENV NEXT_PUBLIC_ATLAS_CHART_RFPOWER_URL=$NEXT_PUBLIC_ATLAS_CHART_RFPOWER_URL
ENV NEXT_PUBLIC_ATLAS_CHART_METRICS_URL=$NEXT_PUBLIC_ATLAS_CHART_METRICS_URL

# Copy package files first
COPY frontend/package*.json ./
COPY frontend/jsconfig.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy entire frontend directory
COPY frontend/ .

# Build the application
RUN npm run build

# Expose port and start
EXPOSE 8080
CMD ["npm", "start", "--", "-p", "8080"]
