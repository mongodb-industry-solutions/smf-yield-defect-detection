# MongoDB Atlas connection string (Flex or dedicated tier recommended for Vector Search + Search indexes)
MONGODB_URI=

# Database name (backend/main.py and most scripts default to "smf-yield-defect" if unset)
MDB_DATABASE_NAME=smf-yield-defect
DATABASE_NAME=smf-yield-defect

# Client appName reported to Atlas (defaults to devrel-demo-vectorsearch-langgraph-semiconductor if unset)
APP_NAME=devrel-demo-vectorsearch-langgraph-semiconductor

# AWS Bedrock (chat completions + embeddings)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Use either AWS_PROFILE (recommended) or static keys below
AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Bedrock model IDs (cross-region inference profiles)
COMPLETION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
HAIKU_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Voyage AI (multimodal embeddings for wafer defect images)
VOYAGE_API_KEY=

# Optional: S3 bucket URI for generated wafer defect images
S3_BUCKET_URI=

# Demo mode / synthetic data generation
DEMO_MODE_ENABLED=true
AUTO_START_DEMO=true
DEMO_INTERVAL_SECONDS=5
DEMO_EXCURSION_PROBABILITY=0.1

# Misc backend tuning
USE_CENTRALIZED_THRESHOLDS=true
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CACHE_SIZE=100
NODE_ENV=development

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
INTERNAL_API_URL=http://localhost:8000
NEXT_PUBLIC_ATLAS_CHART_METRICS_URL=
NEXT_PUBLIC_ATLAS_CHART_PARTICLE_URL=
NEXT_PUBLIC_ATLAS_CHART_RFPOWER_URL=
NEXT_PUBLIC_ATLAS_CHART_TEMPERATURE_URL=
